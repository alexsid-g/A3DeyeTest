{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build solution (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/A3DeyeTest.sln",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build solution (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/A3DeyeTest.sln",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
